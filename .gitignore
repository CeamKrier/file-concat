# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.nx

# impeccable design-tool cache (regenerated locally)
**/.impeccable/hook.cache.json
.impeccable/live/

# Credentials. The repo is public, so these are ignored before they exist —
# `.dev.vars` is where wrangler expects local secrets and it is one `touch`
# away from being committed by anyone working here.
google-search-console-api.json
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Internal planning docs — kept locally, not published to the remote.
# Rooted so it never matches the app's product docs (apps/web/src/content/docs).
/docs/

# The project reading (`pulse`) and everything it writes. A reading names what
# the tool failed at and how few people used it, so unlike its two committed
# siblings in scripts/ it stays on this machine. Output lands in /docs/reviews/,
# already covered above.
/.claude/skills/pulse/

# Redesign working files — kept locally, not published to the remote.
/redesign/
.mcp.json

# Tesseract language models. Running OCR under node caches the model into the
# working directory — 5.2 MB per language, downloaded from a CDN — so any OCR
# run leaves one behind wherever it was started from. Nothing here should ever
# be committed; the same files belong on our own origin (see the OCR options on
# extractOfficeDocument), not in git.
*.traineddata
*.traineddata.gz
