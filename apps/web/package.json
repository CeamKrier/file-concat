    "generate-llms-txt": "tsx scripts/generate-llms-txt.ts",
    "check-vendor-caps": "tsx scripts/check-vendor-caps.ts",
    "prebuild": "pnpm fetch-models && pnpm generate-sitemap && pnpm generate-llms-txt && pnpm check-vendor-caps",
    "dev": "vite dev",
    "shot": "node scripts/shot.mjs",
    "build": "vite build",
