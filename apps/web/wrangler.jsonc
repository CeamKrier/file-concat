{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "file-concat",
  // The token has access to more than one account, so every remote command
  // (deploy, d1 --remote, tail) otherwise fails with "More than one account
  // available but unable to select one in non-interactive mode". Not a secret:
  // it identifies the account, it does not authenticate to it.
  "account_id": "0b39a832fa513101a0e94d2c56ffcde2",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@tanstack/react-start/server-entry",
  // Product counters (ADR-0013). Anonymous, unlinked event rows written by
  // /api/e. Create the database once with:
  //   npx wrangler d1 create fileconcat-metrics
  // then paste the returned id into database_id below.
  "d1_databases": [
    {
      "binding": "METRICS",
      "database_name": "fileconcat-metrics",
      "database_id": "e21266a0-7ec4-4401-bf15-5063326e4a88",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    // Every non-asset URL routes through the SSR worker. We don't prerender
    // anything yet — @cloudflare/vite-plugin@1.22.0 overrides Vite 6's
    // builder.buildApp with its own createBuildApp, which skips the plugin
    // buildApp hook chain that TanStack Start uses to run its prerender
    // pass. Until that's resolved upstream (or we replace CF's buildApp),
    // the docs flash is fixed at the route level (eager MDX glob in
    // routes/docs/$slug.tsx) and worker edge cache carries serving cost.
    "run_worker_first": [
      "/",
      "/app",
      "/docs",
      "/docs/*",
      "/api/*"
    ]
  }
}
