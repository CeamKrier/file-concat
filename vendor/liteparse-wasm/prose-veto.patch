+/// Whether a built grid's cells read as prose cut into columns rather than
+/// tabular data: a frame or rule set around running text, a multi-column
+/// article, a letter. Script-agnostic subset of pdf-inspector's tests
+/// (`is_paragraph_content`, the stacked-box continuation test,
+/// `has_dominant_prose_cell`, `row_stripe_cells_are_prose`); its English
+/// function-word lists are left out. A grid where data-like cells are common is
+/// never prose: rejecting a real table only degrades it to text, but keeping a
+/// phantom one scrambles the page, so every signal is a high bar.
+pub(super) fn cells_read_as_prose(rows: &[Vec<Cell>]) -> bool {
+    use super::paragraphs::{ends_hyphenated, ends_sentence_final};
+    let filled: Vec<(usize, &str)> = rows
+        .iter()
+        .flat_map(|r| r.iter().enumerate())
+        .map(|(c, cell)| (c, cell.text.trim()))
+        .filter(|(_, t)| !t.is_empty())
+        .collect();
+    if filled.is_empty() {
+        return false;
+    }
+    let n = filled.len() as f32;
+    // Words by whitespace, with a run of Han/kana/Hangul counted as one word
+    // per two characters, so unspaced Japanese or Chinese prose still weighs.
+    let words = |t: &str| {
+        t.split_whitespace()
+            .map(
+                |w| match w.chars().filter(|&c| is_cjk(c)).count() {
+                    0 | 1 => 1,
+                    k => k.div_ceil(2),
+                },
+            )
+            .sum::<usize>()
+    };
+    let data_like = filled
+        .iter()
+        .filter(|(_, t)| words(t) <= 4 && t.chars().any(|c| c.is_ascii_digit()))
+        .count();
+    if data_like as f32 >= 0.3 * n {
+        return false;
+    }
+    // Words split at a cell's end: text was cut by a column edge, not laid out
+    // in one.
+    if filled.len() >= 4
+        && filled.iter().filter(|(_, t)| ends_hyphenated(t)).count() as f32 > 0.03 * n
+    {
+        return true;
+    }
+    // A sentence running down a column: an open cell of a few words followed by
+    // a lowercase one. The 3-word floor keeps a units column ("kg", "kg") out.
+    let opens = |t: &str| {
+        words(t) >= 3 && !ends_sentence_final(t) && !t.ends_with([':', ';', ')', '"', '%'])
+    };
+    let starts_lower = |t: &str| t.chars().next().is_some_and(|c| c.is_lowercase());
+    let mut pairs = 0;
+    for (a, b) in rows.iter().zip(rows.iter().skip(1)) {
+        if a.iter()
+            .zip(b)
+            .any(|(x, y)| opens(x.text.trim()) && starts_lower(y.text.trim()))
+        {
+            pairs += 1;
+        }
+    }
+    if pairs >= 2 || (rows.len() > 1 && pairs * 4 >= rows.len() - 1 && pairs > 0) {
+        return true;
+    }
+    // One cell holding most of the text is a paragraph in a box.
+    let total: usize = filled.iter().map(|(_, t)| words(t)).sum();
+    let largest = filled.iter().map(|(_, t)| words(t)).max().unwrap_or(0);
+    if largest >= 60 && largest * 3 >= total {
+        return true;
+    }
+    // Long sentence cells in two or more columns: flowing text fills every
+    // column, a narrative table keeps its sentences in one description column.
+    let mean_len = filled.iter().map(|(_, t)| t.chars().count()).sum::<usize>() as f32 / n;
+    let sentence: Vec<usize> = filled
+        .iter()
+        .filter(|(_, t)| {
+            words(t) >= 10 && t.contains(['.', ',', '\u{3001}', '\u{3002}', '\u{FF0C}'])
+        })
+        .map(|(c, _)| *c)
+        .collect();
+    let mut sentence_cols = sentence.clone();
+    sentence_cols.sort_unstable();
+    sentence_cols.dedup();
+    mean_len > 90.0 && sentence.len() as f32 >= 0.5 * n && sentence_cols.len() >= 2
+}
+
+/// Han ideographs, kana and Hangul: scripts written without spaces between
+/// words. Copied from 2.17.0's `ocr_merge::is_cjk`, which 2.18.0 removed with
+/// the chart-label filter.
+fn is_cjk(c: char) -> bool {
+    matches!(c,
+        '\u{1100}'..='\u{11FF}'   // Hangul Jamo
+        | '\u{3040}'..='\u{30FF}' // Hiragana, Katakana
+        | '\u{3130}'..='\u{318F}' // Hangul Compatibility Jamo
+        | '\u{3400}'..='\u{4DBF}' // CJK Unified Ideographs Extension A
+        | '\u{4E00}'..='\u{9FFF}' // CJK Unified Ideographs
+        | '\u{AC00}'..='\u{D7AF}' // Hangul Syllables
+        | '\u{F900}'..='\u{FAFF}' // CJK Compatibility Ideographs
+        | '\u{FF66}'..='\u{FF9F}' // Halfwidth Katakana
+    )
+}
+
 /// Share of the non-space characters of the lines a run spans that its cells
 /// and interstitials carry, or `None` for a run that is not a pipe table. The
 /// classifier skips the whole span, so whatever the table leaves out is
@@ -7867,4 +7969,72 @@ mod tests {
         };
         assert_eq!(lines_left_out(&run, &lines), vec![2]);
     }
+
+    fn grid(rows: &[&[&str]]) -> Vec<Vec<Cell>> {
+        rows.iter()
+            .map(|r| {
+                r.iter()
+                    .map(|t| Cell {
+                        text: t.to_string(),
+                        bbox: None,
+                    })
+                    .collect()
+            })
+            .collect()
+    }
+
+    #[test]
+    fn prose_cut_into_columns_reads_as_prose() {
+        // Two columns of running text sliced row by row by a page frame.
+        let rows = grid(&[
+            &[
+                "The program began as a pilot in the",
+                "Services are offered to recipients who",
+            ],
+            &[
+                "city and is designed to address the",
+                "face barriers to employment and need",
+            ],
+            &[
+                "barriers that keep recipients from",
+                "case management alongside job readi-",
+            ],
+            &[
+                "work for longer than six months.",
+                "ness classes and job development.",
+            ],
+        ]);
+        assert!(cells_read_as_prose(&rows));
+        // One dominant paragraph next to a short label.
+        let para = "word ".repeat(70);
+        assert!(cells_read_as_prose(&grid(&[
+            &[&para, "NMWorks"],
+            &["", ""]
+        ])));
+        // Unspaced Japanese prose counts by characters.
+        let ja = "事業報告及びその附属明細書は法令及び定款に従い会社の状況を正しく示しているものと認めます".repeat(3);
+        assert!(cells_read_as_prose(&grid(&[&[&ja, "以上"]])));
+    }
+
+    #[test]
+    fn data_and_description_tables_are_not_prose() {
+        let rows = grid(&[
+            &["Mode", "RMS (mA)", "Peak (mA)"],
+            &["Single twitch, 60 mA, 300 us", "0.46", "60"],
+            &["Train of four, 60 mA, 300 us", "0.54", "60"],
+        ]);
+        assert!(!cells_read_as_prose(&rows));
+        // A label column next to long descriptions: sentences in one column.
+        let rows = grid(&[
+            &[
+                "Rehabilitering",
+                "The resident can state their wishes and the staff meet them along the way, asking as they go.",
+            ],
+            &[
+                "Selvbestemmelse",
+                "The two residents could not take part in an interview because of their health, the staff said.",
+            ],
+        ]);
+        assert!(!cells_read_as_prose(&rows));
+    }
 }
